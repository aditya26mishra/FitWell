<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Calorie Summary Card (tappable → nutrition tab) ── -->
        <androidx.cardview.widget.CardView
            android:id="@+id/homeCalorieCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardElevation="2dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/cardBg">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CALORIES TODAY" style="@style/StatLabel"/>
                        <TextView android:id="@+id/tvCalConsumed" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textSize="52sp" android:fontFamily="sans-serif-light" android:textColor="@color/textPrimary" android:layout_marginTop="2dp"/>
                        <TextView android:id="@+id/tvCalGoal" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="of — kcal goal" android:textSize="13sp" android:textColor="@color/textSecondary"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="end">
                        <TextView android:id="@+id/tvCalRemaining" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="— remaining" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/colorGreen"/>
                        <TextView android:id="@+id/tvCalBurned" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0 kcal burned" android:textSize="12sp" android:textColor="@color/accent" android:layout_marginTop="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Tap for details →" android:textSize="10sp" android:textColor="@color/colorPrimary"
                            android:layout_marginTop="6dp"/>
                    </LinearLayout>
                </LinearLayout>
                <ProgressBar android:id="@+id/progressCal" style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent" android:layout_height="10dp"
                    android:progressDrawable="@drawable/progress_accent" android:max="2000" android:progress="0"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Macros Card with progress ── -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" app:cardElevation="2dp" app:cardCornerRadius="20dp" app:cardBackgroundColor="@color/cardBg">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="MACROS" style="@style/StatLabel" android:layout_marginBottom="12dp"/>

                <!-- Protein -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="PROTEIN" android:textSize="10sp" android:textColor="@color/accent"
                        android:fontFamily="sans-serif-medium" android:letterSpacing="0.08"/>
                    <TextView android:id="@+id/tvMacroProtein" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0g" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:textColor="@color/accent"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/pbHomeProtein" style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent" android:layout_height="8dp"
                    android:progressDrawable="@drawable/progress_accent" android:layout_marginBottom="12dp"/>

                <!-- Carbs -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="CARBS" android:textSize="10sp" android:textColor="@color/colorOrange"
                        android:fontFamily="sans-serif-medium" android:letterSpacing="0.08"/>
                    <TextView android:id="@+id/tvMacroCarbs" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0g" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:textColor="@color/colorOrange"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/pbHomeCarbs" style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent" android:layout_height="8dp"
                    android:progressDrawable="@drawable/progress_orange" android:layout_marginBottom="12dp"/>

                <!-- Fat -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="FAT" android:textSize="10sp" android:textColor="@color/colorBlue"
                        android:fontFamily="sans-serif-medium" android:letterSpacing="0.08"/>
                    <TextView android:id="@+id/tvMacroFat" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0g" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:textColor="@color/colorBlue"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/pbHomeFat" style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent" android:layout_height="8dp"
                    android:progressDrawable="@drawable/progress_primary"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Micros Card ── -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" app:cardElevation="2dp" app:cardCornerRadius="20dp" app:cardBackgroundColor="@color/cardBg">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="MICRONUTRIENTS" style="@style/StatLabel" android:layout_marginBottom="8dp"/>
                <LinearLayout android:id="@+id/homeMicroContainer" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
