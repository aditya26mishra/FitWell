<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardElevation="1dp"
    app:cardCornerRadius="14dp"
    app:cardBackgroundColor="@color/cardBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Food image -->
        <ImageView
            android:id="@+id/imgFood"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_surface"
            android:src="@drawable/ic_food_placeholder"/>

        <!-- Name + macros -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFoodName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food Name"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/textPrimary"/>

            <TextView
                android:id="@+id/tvCalsUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="per serving"
                android:textSize="11sp"
                android:textColor="@color/textSecondary"
                android:layout_marginTop="1dp"/>

            <TextView
                android:id="@+id/tvFoodMacros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="P 0g · C 0g · F 0g"
                android:textSize="11sp"
                android:textColor="@color/textSecondary"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Right column: calories, qty counter, actions -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvFoodCals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 kcal"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/accent"
                android:gravity="end"/>

            <!-- Quantity counter row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <ImageButton
                    android:id="@+id/btnQtyMinus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_circle_primary"
                    android:src="@drawable/ic_minus"
                    android:padding="4dp"
                    android:contentDescription="Decrease"/>

                <TextView
                    android:id="@+id/tvFoodQty"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="×1"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/textPrimary"
                    android:gravity="center"/>

                <ImageButton
                    android:id="@+id/btnQtyPlus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_circle_primary"
                    android:src="@drawable/ic_add"
                    android:padding="4dp"
                    android:contentDescription="Increase"/>
            </LinearLayout>

            <!-- Micros + delete row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/btnMicro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Micros"
                    android:textSize="11sp"
                    android:textColor="@color/colorBlue"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_marginEnd="6dp"/>

                <ImageButton
                    android:id="@+id/btnDelete"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_delete"
                    android:contentDescription="Delete"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
